[Unit]
Description=OpenAudioHub headless BlueZ pairing agent
After=bluetooth.service dbus.service
Requires=bluetooth.service
PartOf=bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/lib/openaudiohub/bt_agent.py
Restart=always
RestartSec=5
TimeoutStartSec=15s
TimeoutStopSec=8s
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
